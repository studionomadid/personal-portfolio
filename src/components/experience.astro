---
interface Experience {
  company: string;
  role: string;
  period: string;
  location: string;
  description: string;
  current?: boolean;
}

const experiences: Experience[] = [
  {
    company: "Nomadanalyst",
    role: "System & Tech Engineer",
    period: "March 2022 – Present",
    location: "Bandung, West Java, Indonesia",
    description:
      "Working across data analysis and UI/UX, bridging user experience with front-end implementation.",
    current: true,
  },
  {
    company: "PT. Enak Unik Eksklusif",
    role: "BI Analyst",
    period: "September 2024 – May 2025",
    location: "Bandung, West Java, Indonesia",
    description:
      "Managed social media activities, digital content, and audience engagement.",
  },
  {
    company: "Standard Chartered",
    role: "Security Analyst",
    period: "August 2021 – October 2023",
    location: "Singapore, Singapore",
    description:
      "Worked on secure and user-friendly mobile experiences, with a focus on application security and secure software development.",
  },
  {
    company: "Illo's Hotel",
    role: "Web Designer",
    period: "October 2022 – January 2023",
    location: "Bandung, West Java, Indonesia",
    description:
      "Designed responsive user interfaces, developed wireframes and prototypes, and supported website content management, accessibility, SEO, and maintenance.",
  },
  {
    company: "PT Bank Central Asia Tbk (BCA)",
    role: "Mobile Developer",
    period: "May 2022 – June 2022",
    location: "Jakarta, Indonesia",
    description:
      "Developed secure, user-friendly mobile banking features and collaborated with designers, product managers, and back-end developers.",
  },
  {
    company: "TOV Bandung",
    role: "Fullstack Web Designer",
    period: "October 2019 – March 2022",
    location: "Bandung, West Java, Indonesia",
    description:
      "Worked at the intersection of UI/UX designand front-end development, translating visual concepts into functional interfaces.",
  },
  {
    company: "PT. DJARUM",
    role: "Project Manager",
    period: "August 2018 – April 2019",
    location: "Jakarta, Indonesia",
    description:
      "Managed frontend-focused projects, combining project management practices with an understanding of web and application interfaces.",
  },
  {
    company: "Atlassian",
    role: "Data Analyst",
    period: "April 2013 – October 2016",
    location: "New York, United States",
    description:
      "Worked as a Data Analyst with experience in Big Data across a hybrid New York–Indonesia working environment.",
  },
];
---

<section
  id="experience"
  class="py-16 md:py-24 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <div class="mb-12">
      <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">
        Career
      </h2>

      <h3 class="text-4xl md:text-5xl font-medium">
        Experience
      </h3>

      <p
        class="mt-4 max-w-2xl text-[var(--white-icon)] text-base md:text-lg leading-relaxed"
      >
        A multidisciplinary background across data analysis, cybersecurity,
        UI engineering, mobile development, web design, social media, and
        project management.
      </p>
    </div>

    <div class="relative">
      <div
        class="absolute left-[7px] top-2 bottom-2w-px bg-[var(--white-icon-tr)] md:left-[9px]"
        aria-hidden="true"
      ></div>

      <div class="space-y-10">
        {experiences.map((experience) => (
          <article class="relative pl-8 md:pl-12">
            <div
              class:list={[
                "absolute left-0 top-2 size-4 md:size-5 rounded-full border-2",
                experience.current
                  ? "border-[var(--sec)] bg-[var(--sec)]"
                  : "border-[var(--white-icon-tr)] bg-[var(--background)]",
              ]}
              aria-hidden="true"
            ></div>

            <div
              class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-5 md:p-6 transition-all duration-300 hover:border-[#a476ff40] hover:bg-[#181818]"
            >
              <div
                class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between"
              >
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <h4
                      class="text-xl md:text-2xl font-semibold text-[var(--white)]"
                    >
                      {experience.role}
                    </h4>

                    {
                      experience.current && (
                        <span class="rounded-fullborder border-[#a476ff45] bg-[#a476ff12] px-2.5 py-1 text-xs text-[var(--sec)]">
                          Current
                        </span>
                      )
                    }
                  </div>

                  <p class="mt-1 text-base md:text-lg text-[var(--sec)]">
                    {experience.company}
                  </p>
                </div>

                <span
                  class="shrink-0 text-sm text-[var(--white-icon)] md:text-right"
                >
                  {experience.period}
                </span>
              </div>

              <p class="mt-3 text-sm text-[var(--white-icon)]">
                {experience.location}
              </p>

              <p
                class="mt-4 text-sm md:text-base leading-relaxed text-[var(--white-icon)]"
              >
                {experience.description}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(
      135deg,
      #a476ff 25%,
      #eee5ff 50%,
      #a476ff 75%
    );
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }

    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>