---
const whatsappNumber = "6282119819892";
const whatsappUrl = `https://wa.me/${whatsappNumber}`;
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Lauren Surya on WhatsApp"
  class="whatsapp-float group"
>
  <span class="whatsapp-label">
    WhatsApp
  </span>

  <span
    class="whatsapp-icon"
    aria-hidden="true"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="h-6 w-6"
    >
      <path
        d="M20.52 3.48A11.82 11.82 0 0 0 12.08 0C5.53 0 .2 5.33.2 11.88c0 2.09.55 4.13 1.59 5.93L.1 24l6.34-1.66a11.88 11.88 0 0 0 5.64 1.43h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.17-1.24-6.15-3.45-8.41ZM12.09 21.8h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.76.98 1-3.67-.23-.38a9.88 9.88 0 1 1 8.39 4.66Zm5.42-7.41c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.31 1.27.5 1.71.64.72.23 1.37.2 1.89.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"
      />
    </svg>
  </span>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 1000;

    display: inline-flex;
    align-items: center;
    gap: 0.65rem;

    min-height: 3.25rem;
    padding: 0.75rem 1rem;

    border: 1px solid var(--white-icon-tr);
    border-radius: 9999px;

    background: rgba(16, 16, 16, 0.92);
    color: var(--white);

    text-decoration: none;

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.28),
      0 0 0 1px rgba(255, 255, 255, 0.02);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    transition:
      transform 300ms ease,
      border-color 300ms ease,
      background-color 300ms ease,
      box-shadow 300ms ease;
  }

  .whatsapp-float:hover {
    transform: translateY(-3px);
    border-color: var(--sec);
    background: var(--sec);
    color: var(--background);

    box-shadow:
      0 14px 34px rgba(0, 0, 0, 0.34),
      0 0 24px rgba(164, 118, 255, 0.18);
  }

  .whatsapp-float:focus-visible {
    outline: 2px solid var(--sec);
    outline-offset: 4px;
  }

  .whatsapp-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .whatsapp-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  @media (max-width: 640px) {
    .whatsapp-float {
      right: 1rem;
      bottom: 1rem;

      width: 3.25rem;
      height: 3.25rem;
      min-height: 3.25rem;
      padding: 0;

      justify-content: center;
    }

    .whatsapp-label {
      position: absolute;

      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;

      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;

      border: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      transition: none;
    }

    .whatsapp-float:hover {
      transform: none;
    }
  }
</style>
