---
import { projects } from "../data/projects";

const projectTypeLabel = {
  project: "Project",
  freelance: "Freelance",
  "case-study": "Case Study",
} as const;
---

<section
  id="projects"
  class="relative w-full overflow-hidden bg-[var(--bg)] px-6 py-24 md:px-12 lg:px-20"
  aria-labelledby="projects-heading"
>
  <div class="mx-auto max-w-7xl">
    <!-- Section Header -->
    <header class="mb-16 max-w-3xl">
      <p
        class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-[var(--sec)]"
      >
        Selected Work
      </p>

      <h2
        id="projects-heading"
        class="text-4xl font-semibold tracking-tight text-[var(--white)] md:text-5xl lg:text-6xl"
      >
        Projects
      </h2>

      <p
        class="mt-6 text-base leading-7 text-[var(--white-icon)] md:text-lg md:leading-8"
      >
        A collection of technology, business analysis, and digital
        transformation projects focused on solving real-world problems
        through structured thinking, data, design, and technology.
      </p>
    </header>

    <!-- Projects -->
    <div class="space-y-8 md:space-y-10">
      {
        projects.map((project, index) => (
          <article
            class="group relative overflow-hidden rounded-3xl border border-[var(--white-icon-tr)] bg-[#1414149c] transition-all duration-500 hover:border-[var(--sec)]/40"
            aria-labelledby={`project-${index + 1}-title`}
          >
            <div class="p-6 md:p-8 lg:p-10">
              <!-- Project Header -->
              <header class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
                <!-- Project Number -->
                <div
                  class="text-xs font-medium tracking-[0.2em] text-[var(--sec)] md:text-sm"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </div>

                <!-- Project Metadata -->
                <div
                  class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.15em] text-[var(--white-icon)] md:justify-end"
                  aria-label="Project metadata"
                >
                  <span
                    class={`rounded-full border px-3 py-1.5 ${
                      project.type === "freelance"
                        ? "border-[var(--sec)]/40 text-[var(--sec)]"
                        : project.type === "case-study"
                          ? "border-[var(--white)]/30 text-[var(--white)]"
                          : "border-[var(--white-icon-tr)] text-[var(--white-icon)]"
                    }`}
                  >
                    {project.type
                      ? projectTypeLabel[project.type]
                      : "Project"}
                  </span>

                  {project.year && (
                    <>
                      <span class="opacity-30" aria-hidden="true">
                        /
                      </span>
                      <span>{project.year}</span>
                    </>
                  )}

                  <span class="opacity-30" aria-hidden="true">
                    /
                  </span>

                  <span>{project.status}</span>
                </div>
              </header>

              <!-- Project Identity -->
              <div class="mt-8 max-w-5xl md:mt-10">
                <h3
                  id={`project-${index + 1}-title`}
                  class="text-2xl font-semibold tracking-tight text-[var(--white)] md:text-3xl lg:text-4xl"
                >
                  {project.title}
                </h3>

                <p class="mt-3 text-sm font-medium text-[var(--sec)] md:text-base">
                  {project.category}
                </p>

                <p class="mt-5 max-w-4xl text-sm leading-7 text-[var(--white-icon)] md:mt-6 md:text-base md:leading-8">
                  {project.description}
                </p>
              </div>

              <!-- Project Details -->
              <div class="mt-10 grid gap-10 border-t border-[var(--white-icon-tr)] pt-8 md:mt-12 md:grid-cols-2 md:pt-10">
                <!-- Role -->
                <div>
                  <h4 class="mb-4 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                    Role
                  </h4>

                  <p class="max-w-xl text-sm leading-7 text-[var(--white-icon)] md:text-base md:leading-8">
                    {project.role}
                  </p>

                  {project.client && (
                    <p class="mt-3 text-sm leading-6 text-[var(--white-icon)]">
                      Client: {project.client}
                    </p>
                  )}
                </div>

                <!-- Highlights -->
                <div>
                  <h4 class="mb-4 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                    Scope & Contribution
                  </h4>

                  <ul class="space-y-3 text-sm leading-6 text-[var(--white-icon)] md:text-base md:leading-7">
                    {project.highlights.map((highlight) => (
                      <li class="flex items-start gap-3">
                        <span
                          class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[var(--sec)]"
                          aria-hidden="true"
                        />
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Technology & Methods -->
              <div class="mt-10">
                <h4 class="mb-4 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                  Technology & Methods
                </h4>

                <div class="flex flex-wrap gap-2">
                  {project.stack.map((technology) => (
                    <span
                      class="rounded-full border border-[var(--white-icon-tr)] px-3 py-1.5 text-xs text-[var(--white-icon)] transition-colors duration-300 group-hover:border-[var(--white-icon)]/30"
                    >
                      {technology}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Case Study -->
              {project.caseStudy && (
                <section
                  class="mt-10 border-t border-[var(--white-icon-tr)] pt-8 md:mt-12 md:pt-10"
                  aria-labelledby={`case-study-${index + 1}-title`}
                >
                  <header class="mb-8 max-w-3xl md:mb-10">
                    <p class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--sec)]">
                      Case Study
                    </p>

                    <h4
                      id={`case-study-${index + 1}-title`}
                      class="text-2xl font-semibold tracking-tight text-[var(--white)] md:text-3xl"
                    >
                      From Problem to Structured Solution
                    </h4>

                    <p class="mt-4 max-w-2xl text-sm leading-7 text-[var(--white-icon)] md:text-base md:leading-8">
                      A structured view of the problem, reasoning, solution, and resulting direction.
                    </p>
                  </header>

                  <div class="grid gap-x-10 gap-y-8 md:grid-cols-2 md:gap-y-10">
                    <!-- Overview -->
                    <div class="relative border-l border-[var(--white-icon-tr)] pl-5 md:pl-6">
                      <span
                        class="mb-3 block text-[10px] font-medium tracking-[0.2em] text-[var(--sec)]"
                        aria-hidden="true"
                      >
                        01
                      </span>

                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Overview
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base md:leading-8">
                        {project.caseStudy.overview}
                      </p>
                    </div>

                    <!-- Context -->
                    <div class="relative border-l border-[var(--white-icon-tr)] pl-5 md:pl-6">
                      <span
                        class="mb-3 block text-[10px] font-medium tracking-[0.2em] text-[var(--sec)]"
                        aria-hidden="true"
                      >
                        02
                      </span>

                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Context
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base md:leading-8">
                        {project.caseStudy.context}
                      </p>
                    </div>

                    <!-- Problem -->
                    <div class="relative border-l border-[var(--white-icon-tr)] pl-5 md:pl-6">
                      <span
                        class="mb-3 block text-[10px] font-medium tracking-[0.2em] text-[var(--sec)]"
                        aria-hidden="true"
                      >
                        03
                      </span>

                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Problem
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base md:leading-8">
                        {project.caseStudy.problem}
                      </p>
                    </div>

                    <!-- Approach -->
                    <div class="relative border-l border-[var(--white-icon-tr)] pl-5 md:pl-6">
                      <span
                        class="mb-3 block text-[10px] font-medium tracking-[0.2em] text-[var(--sec)]"
                        aria-hidden="true"
                      >
                        04
                      </span>

                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Approach
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base md:leading-8">
                        {project.caseStudy.approach}
                      </p>
                    </div>

                    <!-- Solution -->
                    <div class="relative border-l border-[var(--white-icon-tr)] pl-5 md:pl-6">
                      <span
                        class="mb-3 block text-[10px] font-medium tracking-[0.2em] text-[var(--sec)]"
                        aria-hidden="true"
                      >
                        05
                      </span>

                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Solution
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base md:leading-8">
                        {project.caseStudy.solution}
                      </p>
                    </div>

                    <!-- Outcome -->
                    <div class="relative border-l border-[var(--sec)]/50 pl-5 md:pl-6">
                      <span
                        class="mb-3 block text-[10px] font-medium tracking-[0.2em] text-[var(--sec)]"
                        aria-hidden="true"
                      >
                        06
                      </span>

                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Outcome
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base md:leading-8">
                        {project.caseStudy.outcome}
                      </p>
                    </div>
                  </div>
                </section>
              )}

              <!-- Project Document -->
              {project.document && (
                <div class="mt-10 border-t border-[var(--white-icon-tr)] pt-8 md:mt-12">
                  <a
                    href={project.document.path}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-3 rounded-full border border-[var(--white)] px-5 py-3 text-sm font-medium text-[var(--white)] transition-all duration-300 hover:bg-[var(--white)] hover:text-[var(--bg)] focus:outline-none focus:ring-2 focus:ring-[var(--sec)] focus:ring-offset-2 focus:ring-offset-[var(--bg)]"
                    aria-label={`${project.document.label}: ${project.title}`}
                  >
                    <span>{project.document.label}</span>

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5"
                      aria-hidden="true"
                    >
                      <path d="M14 3H21V10H19V6.414L10.707 14.707L9.293 13.293L17.586 5H14V3ZM5 5H11V7H5C4.448 7 4 7.448 4 8V19C4 19.552 4.448 20 5 20H16C16.552 20 17 19.552 17 19V13H19V19C19 20.657 17.657 22 16 22H5C3.343 22 2 20.657 2 19V8C2 6.343 3.343 5 5 5Z" />
                    </svg>
                  </a>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
