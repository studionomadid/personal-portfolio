---
import { projects } from "../data/projects";
---

<section
  id="projects"
  class="relative w-full overflow-hidden bg-[var(--bg)] px-6 py-24 md:px-12 lg:px-20"
>
  <div class="mx-auto max-w-7xl">
    <!-- Section Header -->
    <div class="mb-16 max-w-3xl">
      <p
        class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-[var(--sec)]"
      >
        Selected Work
      </p>

      <h2
        class="text-4xl font-semibold tracking-tight text-[var(--white)] md:text-5xl lg:text-6xl"
      >
        Projects
      </h2>

      <p
        class="mt-6 text-base leading-7 text-[var(--white-icon)] md:text-lg"
      >
        A collection of technology, business analysis, and digital
        transformation projects focused on solving real-world problems
        through structured thinking, data, design, and technology.
      </p>
    </div>

    <!-- Projects -->
    <div class="space-y-8">
      {
        projects.map((project, index) => (
          <article class="group relative overflow-hidden rounded-3xl border border-[var(--white-icon-tr)] bg-[#1414149c] transition-all duration-300 hover:border-[var(--sec)]/40">
            <div class="p-6 md:p-8 lg:p-10">
              <!-- Project Meta -->
              <div class="mb-6 flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.15em] text-[var(--white-icon)]">
                <span
                  class={`rounded-full border px-3 py-1.5 ${
                    project.type === "freelance"
                      ? "border-[var(--sec)]/40 text-[var(--sec)]"
                      : project.type === "case-study"
                        ? "border-[var(--white)]/30 text-[var(--white)]"
                        : "border-[var(--white-icon-tr)] text-[var(--white-icon)]"
                  }`}
                >
                  {project.type ?? "project"}
                </span>

                {project.year && (
                  <>
                    <span class="opacity-40">/</span>
                    <span>{project.year}</span>
                  </>
                )}

                <span class="opacity-40">/</span>

                <span>{project.status}</span>
              </div>

              <!-- Project Number -->
              <div class="mb-4 text-sm text-[var(--sec)] opacity-70">
                {String(index + 1).padStart(2, "0")}
              </div>

              <!-- Title -->
              <h3 class="max-w-4xl text-2xl font-semibold tracking-tight text-[var(--white)] md:text-3xl lg:text-4xl">
                {project.title}
              </h3>

              <!-- Category -->
              <p class="mt-3 text-sm font-medium text-[var(--sec)] md:text-base">
                {project.category}
              </p>

              <!-- Description -->
              <p class="mt-6 max-w-4xl text-sm leading-7 text-[var(--white-icon)] md:text-base md:leading-8">
                {project.description}
              </p>

              <!-- Details Grid -->
              <div class="mt-10 grid gap-10 md:grid-cols-2">
                <!-- Role -->
                <div>
                  <h4 class="mb-4 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                    Role
                  </h4>

                  <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base">
                    {project.role}
                  </p>

                  {project.client && (
                    <p class="mt-2 text-sm text-[var(--white-icon)]">
                      Client: {project.client}
                    </p>
                  )}
                </div>

                <!-- Highlights -->
                <div>
                  <h4 class="mb-4 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                    Scope & Contribution
                  </h4>

                  <ul class="space-y-2 text-sm leading-6 text-[var(--white-icon)] md:text-base">
                    {project.highlights.map((highlight) => (
                      <li class="flex items-start gap-3">
                        <span class="mt-2 h-1 w-1 flex-shrink-0 rounded-full bg-[var(--sec)]" />
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Technology Stack -->
              <div class="mt-10">
                <h4 class="mb-4 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                  Technology Stack
                </h4>

                <div class="flex flex-wrap gap-2">
                  {project.stack.map((technology) => (
                    <span class="rounded-full border border-[var(--white-icon-tr)] px-3 py-1.5 text-xs text-[var(--white-icon)]">
                      {technology}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Case Study -->
              {project.caseStudy && (
                <div class="mt-12 border-t border-[var(--white-icon-tr)] pt-10">
                  <div class="mb-8">
                    <p class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--sec)]">
                      Case Study
                    </p>

                    <h4 class="text-2xl font-semibold tracking-tight text-[var(--white)] md:text-3xl">
                      From Problem to Structured Solution
                    </h4>
                  </div>

                  <div class="grid gap-x-10 gap-y-8 md:grid-cols-2">
                    <!-- Overview -->
                    <div>
                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Overview
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base">
                        {project.caseStudy.overview}
                      </p>
                    </div>

                    <!-- Context -->
                    <div>
                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Context
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base">
                        {project.caseStudy.context}
                      </p>
                    </div>

                    <!-- Problem -->
                    <div>
                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Problem
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base">
                        {project.caseStudy.problem}
                      </p>
                    </div>

                    <!-- Approach -->
                    <div>
                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Approach
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base">
                        {project.caseStudy.approach}
                      </p>
                    </div>

                    <!-- Solution -->
                    <div>
                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Solution
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base">
                        {project.caseStudy.solution}
                      </p>
                    </div>

                    <!-- Outcome -->
                    <div>
                      <h5 class="mb-3 text-xs font-medium uppercase tracking-[0.15em] text-[var(--white)]">
                        Outcome
                      </h5>

                      <p class="text-sm leading-7 text-[var(--white-icon)] md:text-base">
                        {project.caseStudy.outcome}
                      </p>
                    </div>
                  </div>
                </div>
              )}

              <!-- Project Document -->
              {project.document && (
                <div class="mt-10 border-t border-[var(--white-icon-tr)] pt-8">
                  <a
                    href={project.document.path}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/link inline-flex items-center gap-3 rounded-full border border-[var(--white)] px-5 py-3 text-sm font-medium text-[var(--white)] transition-all duration-300 hover:bg-[var(--white)] hover:text-[var(--bg)]"
                    aria-label={`${project.document.label}: ${project.title}`}
                  >
                    <span>{project.document.label}</span>

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-4 w-4 transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
                      aria-hidden="true"
                    >
                      <path d="M14 3H21V10H19V6.414L10.707 14.707L9.293 13.293L17.586 5H14V3ZM5 5H11V7H5C4.448 7 4 7.448 4 8V19C4 19.552 4.448 20 5 20H16C16.552 20 17 19.552 17 19V13H19V19C19 20.657 17.657 22 16 22H5C3.343 22 2 20.657 2 19V8C2 6.343 3.343 5 5 5Z" />
                    </svg>
                  </a>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>