---
interface Project {
  title: string;
  category: string;
  description: string;
  highlights: string[];
  status: string;
}

const projects: Project[] = [
  {
    title: "NOMAD Agency",
    category: "Freelance / Digital Solutions",
    description:
      "Digital and business solution projects covering UI/UX, web development, digital campaigns, system development, and technology-driven solutions.",
    highlights: [
      "UI/UX & digital experience",
      "Web & application development",
      "Digital marketing & campaign strategy",
      "Business and technology solutions",
    ],
    status: "Freelance Portfolio",
  },
  {
    title: "GN Central System — 1st Deployment",
    category: "Business & System Analysis",
    description:
      "Business analysis and system transformation initiative focused on understanding existing business processes, financial conditions, data flows, operational systems, and preparing structured system improvements.",
    highlights: [
      "Business process & system analysis",
      "Financial & ratio analysis",
      "Data Flow Diagram (DFD)",
      "SOP & operational improvement",
      "System migration planning",
      "Reporting & decision support",
    ],
    status: "System Analysis Project",
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">
      Selected work
    </h2>

    <h3 class="text-4xl md:text-5xl font-medium mb-8">
      Projects
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <article
            class="group rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6 transition-all duration-300 hover:border-[var(--sec)]/30 hover:bg-[#181818]"
          >
            <div class="flex items-start justify-between gap-4 mb-6">
              <div>
                <span class="text-sm text-[var(--sec)]">
                  {project.category}
                </span>

                <h4 class="text-2xl md:text-3xl font-semibold mt-2">
                  {project.title}
                </h4>
              </div>

              <div
                class="size-11 shrink-0 rounded-xl border border-[var(--white-icon-tr)] flex items-center justify-center text-[var(--sec)]"
                aria-hidden="true"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-5"
                >
                  <path d="M12 2C6.477 2 2 6.477 2 12C2 17.523 6.477 22 12 22C17.523 22 22 17.523 22 12C22 6.477 17.523 2 12 2ZM11 7H13V11H17V13H13V17H11V13H7V11H11V7Z" />
                </svg>
              </div>
            </div>

            <p class="text-sm md:text-base leading-relaxed text-[var(--white-icon)] mb-6">
              {project.description}
            </p>

            <div class="border-t border-[var(--white-icon-tr)] pt-5">
              <p class="text-xs uppercase tracking-wider text-[var(--white-icon)] mb-3">
                Scope
              </p>

              <ul class="space-y-2">
                {
                  project.highlights.map((highlight) => (
                    <li class="flex items-start gap-3 text-sm text-[var(--white)]">
                      <span class="text-[var(--sec)] mt-0.5">•</span>
                      <span>{highlight}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="mt-6 pt-5 border-t border-[var(--white-icon-tr)]">
              <span class="text-sm text-[var(--white-icon)]">
                {project.status}
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>