---
import WhatsApp from "../components/whatsapp.astro";
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const siteUrl =
  Astro.site ??
  new URL("https://studionomadid.github.io/personal-portfolio/");

const canonicalUrl = new URL(
  Astro.url.pathname,
  siteUrl,
).href;

const ogImageUrl = new URL(
  "og.image.png",
  siteUrl,
).href;

const faviconUrl = new URL(
  "favicon.png",
  siteUrl,
).href;

const fontUrl = new URL(
  "fonts/montserrat-latin-wght-normal.woff2",
  siteUrl,
).href;

const metaDescription =
  description ??
  "Lauren Surya — Technology Professional working across software engineering, systems, data, cybersecurity, and digital experience.";

const pageTitle =
  title === "Lauren Surya"
    ? "Lauren Surya | Technology Professional"
    : `${title} | Lauren Surya`;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <title>{pageTitle}</title>

    <meta
      name="description"
      content={metaDescription}
    />

    <meta
      name="author"
      content="Lauren Surya"
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="theme-color"
      content="#101010"
    />

    <link
      rel="icon"
      type="image/png"
      href={faviconUrl}
    />

    <!-- Canonical -->

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <!-- Open Graph -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:title"
      content={pageTitle}
    />

    <meta
      property="og:description"
      content={metaDescription}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:site_name"
      content="Lauren Surya"
    />

    <meta
      property="og:image"
      content={ogImageUrl}
    />

    <meta
      property="og:image:alt"
      content="Lauren Surya — Technology Professional Portfolio"
    />

    <!-- Twitter / X -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={pageTitle}
    />

    <meta
      name="twitter:description"
      content={metaDescription}
    />

    <meta
      name="twitter:image"
      content={ogImageUrl}
    />

    <meta
      name="twitter:image:alt"
      content="Lauren Surya — Technology Professional Portfolio"
    />

    <!-- Font -->

    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Structured Data: Person -->

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Lauren Surya",
        "url": "https://studionomadid.github.io/personal-portfolio/",
        "jobTitle": "Technology Professional",
        "description": "Lauren Surya is a technology professional working across software engineering, systems, data, cybersecurity, and digital experience.",
        "sameAs": [
          "https://github.com/studionomadid"
        ]
      }
    </script>

    <!-- Structured Data: WebSite -->

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Lauren Surya Portfolio",
        "url": "https://studionomadid.github.io/personal-portfolio/",
        "description": "Portfolio of Lauren Surya — Technology Professional working across software engineering, systems, data, cybersecurity, and digital experience.",
        "author": {
          "@type": "Person",
          "name": "Lauren Surya",
          "url": "https://studionomadid.github.io/personal-portfolio/"
        }
      }
    </script>
  </head>

  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
    <WhatsApp />
  </body>
</html>

<style is:global define:vars={{ fontUrl }}>
  @font-face {
    font-family: "Montserrat Variable";
    src: url(var(--fontUrl)) format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
