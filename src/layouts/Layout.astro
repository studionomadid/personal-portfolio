---
interface Props {
  title: string;
}

const { title } = Astro.props;

const base = import.meta.env.BASE_URL;

const siteUrl =
  Astro.site ??
  new URL("https://studionomadid.github.io/personal-portfolio/");

const canonicalUrl = new URL(base, siteUrl).href;
const ogImageUrl = new URL(`${base}og.image.png`, siteUrl).href;

const fontUrl = `${base}fonts/montserrat-latin-wght-normal.woff2`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <title>{title} | Lauren Surya</title>

    <meta
      name="description"
      content="Lauren Surya — DevOps, Data Analyst, UI/UX Designer, and technology professional focused on building structured digital systems, data-driven solutions, and user-centered experiences."
    />

    <meta
      name="keywords"
      content="Lauren Surya, DevOps, Data Analyst, UI/UX Designer, Cybersecurity, Web Development, Digital Systems, Technology Portfolio"
    />

    <meta name="author" content="Lauren Surya" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="theme-color" content="#101010" />

    <link
      rel="icon"
      type="image/png"
      href={`${base}favicon.png`}
    />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Font -->
    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Open Graph -->
    <meta
      property="og:title"
      content="Lauren Surya | Portfolio"
    />

    <meta
      property="og:description"
      content="Portfolio of Lauren Surya — DevOps, Data Analyst, UI/UX Designer, and technology professional building digital solutions."
    />

    <meta
      property="og:image"
      content={ogImageUrl}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="Lauren Surya Portfolio"
    />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Lauren Surya",
        "url": "https://studionomadid.github.io/personal-portfolio/",
        "jobTitle": "DevOps, Data Analyst & UI/UX Designer",
        "description": "Lauren Surya is a technology professional working across DevOps, data analysis, UI/UX design, cybersecurity, and digital systems."
      }
    </script>
  </head>

  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global define:vars={{ fontUrl }}>
  @font-face {
    font-family: "Montserrat Variable";
    src: url(var(--fontUrl)) format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
